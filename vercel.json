{
  "rewrites": [
    { "source": "/assets/:file", "destination": "/assets/:file" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/og-preview.png", "destination": "/og-preview.png" },
    { "source": "/placeholder.svg", "destination": "/placeholder.svg" },
    { "source": "/sw.js", "destination": "/sw.js" },
    { "source": "/registerSW.js", "destination": "/registerSW.js" },
    { "source": "/manifest.webmanifest", "destination": "/manifest.webmanifest" },
    { "source": "/workbox-:file", "destination": "/workbox-:file" },
    { "source": "/:path", "destination": "/index.html", "status": 200 }
  ]
}