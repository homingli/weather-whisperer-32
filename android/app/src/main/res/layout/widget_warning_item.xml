<?xml version="1.0" encoding="utf-8"?>
<!-- One active warning inside a widget's warnings row, inflated once per
     alert by WidgetStore.applyWarnings: the official HKO icon when a bitmap
     shipped in the payload, else the text badge pill. Kept compact — the
     2x1 shares this layout, and every extra dp of per-item footprint
     squeezes the next alert (or the rain verdict) out of its tiny row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginEnd="4dp">

    <ImageView
        android:id="@+id/warning_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_warning_desc"
        android:visibility="gone" />

    <TextView
        android:id="@+id/warning_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/widget_badge_warn"
        android:visibility="gone" />
</LinearLayout>
